# Copier ce fichier en .env (local) ou renseigner ces variables dans Vercel
# (Project → Settings → Environment Variables).

# URL publique du site (canonical, sitemap, Open Graph). Facultatif sur Vercel : par défaut,
# le domaine de production du projet Vercel ; en local : https://jadedeschuyteneer.be
SITE_URL=

# Point d'envoi du formulaire de contact (ex. https://formspree.io/f/xxxxxxx).
# Sans cette variable, le formulaire propose un lien mailto vers PUBLIC_CONTACT_EMAIL.
PUBLIC_FORM_ENDPOINT=

# Adresse e-mail de contact de Jade. Facultatif : par défaut, celle de src/data/site.ts.
PUBLIC_CONTACT_EMAIL=
