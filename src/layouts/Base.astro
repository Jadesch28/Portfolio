---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/animations.css';
import '../styles/transitions.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { site, type NavId } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** Lien actif de la navigation. */
  current?: NavId;
  header?: 'complet' | 'minimal';
  /** Lien qui remplace « Jade D. » dans l'en-tête mobile. */
  retourMobile?: { href: string; label: string };
  footer?: boolean;
  /** Image de partage (Open Graph) ; par défaut /og.png, le tapis et la règle « JADE ». */
  image?: { src: string; width: number; height: number; alt: string };
  /** article pour une page projet. */
  type?: 'website' | 'article';
  /** Données structurées (JSON-LD). */
  jsonLd?: object;
  /** Page à ne pas indexer (404). */
  noindex?: boolean;
}

const {
  title,
  description,
  current,
  header = 'complet',
  retourMobile,
  footer = true,
  image = {
    src: '/og.png',
    width: 1200,
    height: 630,
    alt: `${site.nom} — graphiste, motion designer & illustratrice`,
  },
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;
// Avec build.format 'file', le chemin finit par « .html » au build : on garde l'URL propre servie par Vercel.
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ''), Astro.site);
const imageUrl = new URL(image.src, Astro.site).href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Les apparitions au scroll ne masquent le contenu que si le JavaScript tourne.
         pagereveal (juste avant le premier rendu) : d'où vient-on pendant une transition ?
         - accueil → projet : .from-list cale les entrées de la page projet sur le vol de la photo ;
         - arrivée sur un projet par transition : .vt-arrivee (le visuel arrive en volant) ;
         - projet → accueil : .retour-projet (pas d'apparitions, la photo revole à sa place). -->
    <script is:inline>
      {
        const racine = document.documentElement;
        racine.classList.add('js');
        window.addEventListener('load', () => {
          setTimeout(() => racine.classList.add('defilement-doux'), 0);
        });
        window.addEventListener('pagereveal', (event) => {
          racine.classList.remove('vers-projet', 'from-list', 'vt-arrivee', 'retour-projet');
          if (!event.viewTransition) return;
          const depuis = window.navigation?.activation?.from?.url || document.referrer;
          if (!depuis) return;
          const avant = new URL(depuis).pathname.replace(/(index)?\.html$/, '');
          const ici = location.pathname.replace(/(index)?\.html$/, '');
          const projet = /^\/projets\//;
          if (projet.test(ici)) {
            racine.classList.add('vt-arrivee');
            if (avant === '/') racine.classList.add('from-list');
          } else if (ici === '/' && projet.test(avant)) {
            racine.classList.add('retour-projet');
          }
        });
      }
    </script>
    <!-- Activation des transitions entre pages : déclarée dans la page elle-même pour être connue
         dès le premier rendu (dans une feuille externe, Chrome peut l'ignorer à l'arrivée). -->
    <style is:inline>
      @view-transition {
        navigation: auto;
      }
    </style>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#24503D" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- Partage (Open Graph, cartes Twitter/X) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.nom} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
    <Font cssVariable="--font-stencil" preload />
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-hand" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <div class="site">
      <Header current={current} variant={header} retourMobile={retourMobile} />
      <main id="contenu" tabindex="-1">
        <slot />
      </main>
      {footer && <Footer />}
    </div>
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
