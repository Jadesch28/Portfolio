---
// Champ du formulaire de contact : souligné, saisie en manuscrit, message d'erreur rouille relié par
// aria-describedby. `invalid` sert au rendu statique (styleguide) ; contact-form.ts gère le reste.
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'textarea';
  autocomplete?: string;
  required?: boolean;
  /** Message affiché quand le champ est invalide. */
  erreur?: string;
  invalid?: boolean;
  value?: string;
  class?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  autocomplete,
  required = false,
  erreur,
  invalid = false,
  value,
  class: className,
} = Astro.props;

const erreurId = `${id}-erreur`;
const aria = {
  'aria-invalid': invalid || undefined,
  'aria-describedby': invalid && erreur ? erreurId : undefined,
};
---

<div class:list={['field', className]} data-field>
  <label class="lbl" for={id}>
    {label}
  </label>
  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      class:list={['ta', { err: invalid }]}
      required={required}
      set:text={value ?? ''}
      {...aria}
    />
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      class:list={['inp', { err: invalid }]}
      autocomplete={autocomplete}
      required={required}
      value={value}
      {...aria}
    />
  )}
  {erreur && (
    <p class="hand errtxt" id={erreurId} hidden={!invalid}>
      {erreur}
    </p>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .lbl {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .inp,
  .ta {
    display: block;
    width: 100%;
    margin: 0;
    border: 0;
    background: transparent;
    font-family: var(--f-hand);
    color: var(--ink);
    outline: none;
  }

  .inp {
    min-height: 44px;
    padding: 6px 2px;
    border-bottom: 2px solid #8a7a5e;
    font-size: 24px;
    transition: border-color 0.2s ease;
  }

  .ta {
    min-height: 228px;
    padding: 0;
    resize: vertical;
    font-size: 23px;
    line-height: 38px;
  }

  .inp:focus {
    border-bottom-color: var(--mat);
  }

  .inp:focus-visible,
  .ta:focus-visible,
  .is-focus .inp {
    border-bottom-color: var(--mat);
    outline: 2px dashed var(--mat);
    outline-offset: 4px;
  }

  .inp.err {
    border-bottom-color: var(--rust);
  }

  .errtxt {
    font-size: 19px;
    line-height: 1.3;
    color: var(--rust);
  }

  .errtxt[hidden] {
    display: none;
  }
</style>
