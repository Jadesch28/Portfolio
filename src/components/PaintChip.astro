---
// Nuancier : une couleur sur une carte crème.
interface Props {
  nom: string;
  hex: string;
  /** Rotation en degrés. */
  rotate?: number;
}

const { nom, hex, rotate = 0 } = Astro.props;
---

<figure class="chip" style={`--r: ${rotate}deg`}>
  <span class="couleur" style={`background: ${hex}`}></span>
  <figcaption>
    <span class="nom">{nom}</span>
    <span class="hex">{hex.toUpperCase()}</span>
  </figcaption>
</figure>

<style>
  .chip {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 150px;
    margin: 0;
    padding: 10px 10px 14px;
    color: var(--ink);
    background: var(--photo);
    box-shadow: 0 10px 18px rgba(0, 0, 0, 0.3);
    transform: rotate(var(--r));
  }

  .couleur {
    display: block;
    height: 110px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nom {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .hex {
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }

  @media (max-width: 759.98px) {
    .chip {
      flex: 1;
      width: auto;
      min-width: 0;
      padding: 6px 6px 10px;
      box-shadow: 0 8px 14px rgba(0, 0, 0, 0.3);
    }

    .couleur {
      height: 60px;
    }

    .nom {
      font-size: 13px;
    }
  }
</style>
