---
// Règle pochoir ambrée translucide, avec le texte « découpé » qui laisse voir le tapis.
interface Props {
  title: string;
  subtitle?: string;
  /** Taille du titre (longueur CSS, clamp accepté). */
  size?: string;
  /** Balise du titre (h1 pour le hero et la 404). */
  as?: 'h1' | 'h2' | 'p' | 'span';
  /** Rotation en degrés. */
  rotate?: number;
  class?: string;
}

const {
  title,
  subtitle,
  size = '150px',
  as: Title = 'span',
  rotate = -3,
  class: className,
} = Astro.props;
---

<div class:list={['ruler', className]} style={`--ruler-size: ${size}; --r: ${rotate}deg`}>
  <span class="ticks" aria-hidden="true"></span>
  <Title class="cut stencil titre">{title}</Title>
  {subtitle && <span class="cut stencil sous-titre">{subtitle}</span>}
</div>

<style>
  .ruler {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
    max-width: 100%;
    padding: calc(var(--ruler-size) * 0.17) calc(var(--ruler-size) * 0.19)
      calc(var(--ruler-size) * 0.12);
    border: 1.5px solid var(--amber-border);
    border-radius: 9px;
    background: var(--amber);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.35),
      0 12px 18px rgba(0, 0, 0, 0.35);
    transform: rotate(var(--r));
  }

  /* Graduations : petites tous les 7,8 px, grandes tous les 39 px */
  .ticks {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 0;
    height: 16px;
    background-image:
      repeating-linear-gradient(90deg, rgba(70, 35, 5, 0.7) 0 1px, transparent 1px 7.8px),
      repeating-linear-gradient(90deg, rgba(70, 35, 5, 0.75) 0 1.5px, transparent 1.5px 39px);
    background-size:
      100% 8px,
      100% 16px;
    background-repeat: no-repeat;
  }

  /* Lettres découpées : couleur et grille du tapis vues à travers */
  .cut {
    margin: 0;
    color: var(--mat);
    background-color: var(--mat);
    background-image:
      linear-gradient(rgba(214, 229, 203, 0.25) 1px, transparent 1px),
      linear-gradient(90deg, rgba(214, 229, 203, 0.25) 1px, transparent 1px);
    background-size: 38px 38px;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 1px 0 rgba(255, 226, 180, 0.55));
  }

  .titre {
    display: block;
    font-size: var(--ruler-size);
    line-height: 0.8;
    letter-spacing: 0.03em;
  }

  .sous-titre {
    font-size: calc(var(--ruler-size) * 0.267);
    line-height: 1;
    letter-spacing: 0.07em;
  }
</style>
