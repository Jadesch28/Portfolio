---
// Fiche technique sur papier ligné (ligne rouge sous le titre manuscrit).
// Une ligne sans valeur n'apparaît pas en production ; en dev, elle affiche « [ à compléter ] ».
import { pageProjet } from '../data/site';
import ACompleter from './ACompleter.astro';
import WashiTape from './WashiTape.astro';

interface Props {
  lignes: Array<{ label: string; valeur?: string }>;
  titre?: string;
}

const { lignes, titre = pageProjet.ficheTechnique } = Astro.props;
const visibles = import.meta.env.DEV ? lignes : lignes.filter((l) => l.valeur);
---

<div class="fiche">
  <WashiTape color="sauge" left="38%" top="-12px" width={100} rotate={4} />
  <p class="hand titre">{titre}</p>
  <dl>
    {visibles.map((l) => (
      <div class="ligne">
        <dt>{l.label}</dt>
        <dd>{l.valeur ?? <ACompleter />}</dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .fiche {
    position: relative;
    color: var(--ink);
    background-color: var(--paper);
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.35);
    --focus-color: var(--rust);
  }

  .titre {
    padding: 20px 24px 12px;
    border-bottom: 2px solid var(--card-redline);
    font-size: 30px;
    line-height: 1.1;
    color: var(--rust);
    text-transform: capitalize;
  }

  dl {
    margin: 0;
  }

  .ligne {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    align-items: baseline;
    gap: 14px;
    padding: 12px 24px;
    border-bottom: 1px solid var(--paper-line);
  }

  .ligne:last-child {
    border-bottom: 0;
  }

  dt {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }

  @media (max-width: 759.98px) {
    .titre {
      padding: 16px 18px 10px;
      font-size: 26px;
    }

    .ligne {
      grid-template-columns: 112px minmax(0, 1fr);
      gap: 10px;
      padding: 10px 18px;
    }

    dt {
      font-size: 14px;
    }
  }
</style>
