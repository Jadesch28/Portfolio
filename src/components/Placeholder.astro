---
// Visuel en attente : hachures à 45° sur kraft (clair) ou kraft sombre, libellé centré.
interface Props {
  label: string;
  tone?: 'clair' | 'sombre';
  class?: string;
  style?: string;
}

const { label, tone = 'clair', class: className, style } = Astro.props;
---

<div
  class:list={['ph', `ph--${tone}`, className]}
  style={style}
  role="img"
  aria-label={`Visuel à venir : ${label}`}
>
  <span aria-hidden="true">[ {label} ]</span>
</div>

<style>
  .ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 16px;
    text-align: center;
    font-family: var(--f-text);
    font-size: 14px;
    line-height: 1.4;
    color: #3b2b1d;
    background-color: var(--kraft);
    background-image: repeating-linear-gradient(
      45deg,
      rgba(60, 40, 20, 0.09) 0 2px,
      transparent 2px 11px
    );
  }

  .ph--sombre {
    color: #e6dcc6;
    background-color: var(--kraft-dark);
    background-image: repeating-linear-gradient(
      45deg,
      rgba(230, 220, 198, 0.08) 0 1px,
      transparent 1px 9px
    );
  }
</style>
