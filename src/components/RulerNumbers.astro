---
// Graduations numérotées du tapis (tous les 38 px), en haut du hero : assez pour un écran de
// 5120 px, le surplus est masqué.
const nombres = Array.from({ length: 135 }, (_, i) => i + 1);
---

<div class="nums" aria-hidden="true">
  {nombres.map((n) => (
    <span>{n}</span>
  ))}
</div>

<style>
  .nums {
    position: absolute;
    right: 0;
    left: 0;
    top: 3px;
    overflow: hidden;
    display: flex;
    font-size: 10px;
    line-height: 1;
    color: rgba(237, 230, 211, 0.5);
    pointer-events: none;
  }

  .nums span {
    flex: none;
    width: 38px;
    padding-left: 4px;
  }
</style>
