---
// En-tête : étiquettes Dymo flottantes sur le tapis (sticky, hauteur 0).
// < 760 px : « Jade D. » + « Menu ☰ » dans le flux, qui ouvre le MobileMenu.
// Variante minimale (404) : seulement « Jade D. ».
// `retourMobile` remplace « Jade D. » sous 760 px (page projet : « ← Établi »).
import DymoButton from './DymoButton.astro';
import MobileMenu from './MobileMenu.astro';
import { getProjets, projetHref } from '../data/projets';
import { menuMobile, navigation, site, type NavId } from '../data/site';

interface Props {
  current?: NavId;
  variant?: 'complet' | 'minimal';
  retourMobile?: { href: string; label: string };
}

const { current, variant = 'complet', retourMobile } = Astro.props;
const projets = (await getProjets()).map((p) => ({ titre: p.data.titre, href: projetHref(p) }));
---

<header class="header">
  <div class="bar vt-entete">
    <DymoButton href="/" size="sm" class:list={['marque', { 'marque--desktop': retourMobile }]}>
      {site.nomCourt}
    </DymoButton>
    {retourMobile && (
      <DymoButton href={retourMobile.href} size="sm" variant="ghost" class="retour-mobile">
        {retourMobile.label}
      </DymoButton>
    )}
    {variant === 'complet' && (
      <>
        <nav class="nav" aria-label="Navigation principale">
          {navigation.map((lien) => (
            <DymoButton
              href={lien.href}
              size="sm"
              variant={lien.id === 'contact' ? 'rouille' : 'noir'}
              current={current === lien.id}
            >
              {lien.label}
            </DymoButton>
          ))}
        </nav>
        <span class="menu-btn">
          <DymoButton
            size="sm"
            variant="rouille"
            aria-haspopup="dialog"
            aria-controls="menu-mobile"
            aria-expanded="false"
            data-menu-open
          >
            {menuMobile.ouvrir} <span aria-hidden="true">☰</span>
          </DymoButton>
        </span>
      </>
    )}
  </div>
</header>
{variant === 'complet' && <MobileMenu current={current} projets={projets} />}

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 0;
  }

  .bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 0 var(--gutter-header);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .menu-btn,
  .bar :global(.retour-mobile) {
    display: none;
  }

  @media (max-width: 759.98px) {
    .header {
      position: relative;
      height: auto;
    }

    .bar {
      position: static;
      padding: 14px 16px;
    }

    .nav {
      display: none;
    }

    .menu-btn {
      display: contents;
    }

    .bar :global(.marque--desktop) {
      display: none;
    }

    .bar :global(.retour-mobile) {
      display: inline-flex;
    }
  }
</style>
