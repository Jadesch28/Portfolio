---
// En-tête : étiquettes Dymo flottantes sur le tapis (sticky, hauteur 0).
// < 760 px : « Jade D. » + « Menu ☰ » dans le flux, qui ouvre le MobileMenu.
// Variante minimale (404) : seulement « Jade D. ».
import DymoButton from './DymoButton.astro';
import MobileMenu from './MobileMenu.astro';
import { menuMobile, navigation, site, type NavId } from '../data/site';

interface Props {
  current?: NavId;
  variant?: 'complet' | 'minimal';
}

const { current, variant = 'complet' } = Astro.props;
---

<header class="header">
  <div class="bar">
    <DymoButton href="/" size="sm">
      {site.nomCourt}
    </DymoButton>
    {variant === 'complet' && (
      <>
        <nav class="nav" aria-label="Navigation principale">
          {navigation.map((lien) => (
            <DymoButton
              href={lien.href}
              size="sm"
              variant={lien.id === 'contact' ? 'rouille' : 'noir'}
              current={current === lien.id}
            >
              {lien.label}
            </DymoButton>
          ))}
        </nav>
        <span class="menu-btn">
          <DymoButton
            size="sm"
            variant="rouille"
            aria-haspopup="dialog"
            aria-controls="menu-mobile"
            aria-expanded="false"
            data-menu-open
          >
            {menuMobile.ouvrir} <span aria-hidden="true">☰</span>
          </DymoButton>
        </span>
      </>
    )}
  </div>
</header>
{variant === 'complet' && <MobileMenu current={current} />}

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: 0;
  }

  .bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 18px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 0 var(--gutter-header);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .menu-btn {
    display: none;
  }

  @media (max-width: 759.98px) {
    .header {
      position: relative;
      height: auto;
    }

    .bar {
      position: static;
      padding: 14px 16px;
    }

    .nav {
      display: none;
    }

    .menu-btn {
      display: contents;
    }
  }
</style>
