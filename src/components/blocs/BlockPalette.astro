---
// Bloc « palette » autonome (avec titre). Sans titre, la palette se range dans le bloc texte qui précède.
import PaintChip from '../PaintChip.astro';
import BlocTitre from './BlocTitre.astro';

interface Props {
  etiquette?: string;
  couleurs: Array<{ nom: string; hex: string }>;
}

const { etiquette, couleurs } = Astro.props;
const rotations = [-3, 2, -1, 3, -2];
---

{etiquette && <BlocTitre etiquette={etiquette} />}
<div class="nuancier">
  {couleurs.map((c, i) => (
    <PaintChip nom={c.nom} hex={c.hex} rotate={rotations[i % rotations.length]} />
  ))}
</div>

<style>
  .nuancier {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }

  @media (max-width: 759.98px) {
    .nuancier {
      gap: 10px;
    }
  }
</style>
