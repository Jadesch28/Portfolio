---
// En-tête d'un bloc de page projet : libellé + note manuscrite facultative.
import Etiquette from '../Etiquette.astro';

interface Props {
  etiquette: string;
  note?: string;
  /** Petite indication propre au mobile (ex. « ← glisse → »). */
  noteMobile?: string;
}

const { etiquette, note, noteMobile } = Astro.props;
---

<div class="bloc-titre">
  <h2 class="rv3">
    <Etiquette>{etiquette}</Etiquette>
  </h2>
  {note && <p class="hand note rv4">{note}</p>}
  {noteMobile && <p class="hand note note--mobile rv4">{noteMobile}</p>}
</div>

<style>
  .bloc-titre {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 40px;
  }

  h2 {
    margin: 0;
    font: inherit;
    line-height: 0;
  }

  .note {
    font-size: 26px;
    text-transform: capitalize;
    line-height: 1.2;
    color: var(--mustard);
  }

  .note--mobile {
    display: none;
  }

  @media (max-width: 759.98px) {
    .bloc-titre {
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 16px;
    }

    .note {
      display: none;
    }

    .note--mobile {
      display: block;
      font-size: 20px;
    }
  }
</style>
