---
// Citation manuscrite : « Ce que j'en retiens ».
import { pageProjet } from '../data/site';
import DymoButton from './DymoButton.astro';

interface Props {
  texte: string;
  etiquette?: string;
}

const { texte, etiquette = pageProjet.ceQueJenRetiens } = Astro.props;
---

<figure class="quote">
  <DymoButton as="span">{etiquette}</DymoButton>
  <blockquote>
    <p class="hand">« {texte} »</p>
  </blockquote>
</figure>

<style>
  .quote {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    max-width: 1000px;
    margin: 0;
  }

  blockquote {
    margin: 0;
  }

  p {
    font-size: clamp(34px, 3.8vw, 54px);
    line-height: 1.2;
  }
</style>
