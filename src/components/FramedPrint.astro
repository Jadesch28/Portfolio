---
// Tirage bordé : bord crème de 12 px, ombre « papier posé ».
import type { Visuel as VisuelData } from '../data/projets';
import Visuel from './Visuel.astro';

interface Props {
  visuel?: VisuelData;
  placeholder?: string;
  /** Rotation en degrés. */
  rotate?: number;
  tone?: 'clair' | 'sombre';
  /** Hauteur fixe (image recadrée). Sans hauteur : proportions de l'image. */
  height?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
}

const {
  visuel,
  placeholder,
  rotate = 0,
  tone = 'sombre',
  height,
  sizes,
  priority,
  class: className,
} = Astro.props;

// Un Placeholder a besoin d'une hauteur ; une image sans hauteur garde ses proportions.
const carre = visuel?.carre === true;
const hauteur = height ?? (visuel?.src || carre ? undefined : '460px');
---

<div
  class:list={[
    'print',
    { 'print--fixe': hauteur, 'print--carre': carre },
    visuel?.fond && `print--${visuel.fond}`,
    className,
  ]}
  style={[`--r: ${rotate}deg`, hauteur && `--h: ${hauteur}`].filter(Boolean).join('; ')}
>
  <Visuel
    visuel={visuel}
    label={placeholder}
    tone={tone}
    fit={visuel?.fond ? 'contenu' : hauteur || carre ? 'cover' : 'naturel'}
    sizes={sizes}
    priority={priority}
  />
</div>

<style>
  .print {
    border: 12px solid var(--photo);
    background: var(--photo);
    box-shadow: 0 16px 28px rgba(0, 0, 0, 0.35);
    transform: rotate(var(--r));
  }

  .print--fixe {
    height: var(--h);
  }

  .print--carre {
    aspect-ratio: 1;
  }

  /* Élément détouré : montré en entier, avec un peu d'air */
  .print--clair,
  .print--sombre {
    padding: 14px;
    background: var(--paper);
  }

  .print--sombre {
    background: var(--kraft-dark);
  }

  @media (max-width: 759.98px) {
    .print {
      border-width: 10px;
      box-shadow: 0 14px 22px rgba(0, 0, 0, 0.35);
    }
  }
</style>
