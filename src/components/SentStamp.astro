---
// Tampon « ENVOYÉ / merci ! » : arrive d'un coup sec (« thump ») quand il devient visible.
import { formulaire } from '../data/site';

interface Props {
  tone?: 'rouille' | 'moutarde';
}

const { tone = 'rouille' } = Astro.props;
---

<p class:list={['stamp', 'stencil', `stamp--${tone}`]}>
  {formulaire.tampon}
  <span class="merci">{formulaire.tamponMerci}</span>
</p>

<style>
  .stamp {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding: 14px 26px;
    border: 4px solid var(--stamp);
    border-radius: 8px;
    font-size: 56px;
    line-height: 1;
    letter-spacing: 0.06em;
    color: var(--stamp);
    opacity: 0.9;
    transform: rotate(-8deg);
    animation: stamp-thump 0.5s var(--e-stick) both;
  }

  .stamp--rouille {
    --stamp: var(--rust);
    mix-blend-mode: multiply;
  }

  .stamp--moutarde {
    --stamp: var(--mustard);
  }

  .merci {
    margin-top: 4px;
    font-family: var(--f-text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  @keyframes stamp-thump {
    0% {
      opacity: 0;
      transform: scale(2.2) rotate(-25deg);
    }
    60% {
      opacity: 0.95;
      transform: scale(0.95) rotate(-6deg);
    }
  }

  @keyframes stamp-fade {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stamp {
      animation: stamp-fade 0.2s ease both;
    }
  }
</style>
