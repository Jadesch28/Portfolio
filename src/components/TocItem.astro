---
// Une ligne du carnet sommaire : numéro pochoir, titre, catégorie, cercle au crayon si actif.
import { deuxChiffres, type Projet } from '../data/projets';

interface Props {
  projet: Projet;
  actif?: boolean;
}

const { projet, actif = false } = Astro.props;
---

<a
  href={`#projet-${projet.id}`}
  class:list={['toc', { 'is-active': actif }]}
  aria-current={actif ? 'true' : undefined}
  data-toc={projet.id}
  data-toc-numero={deuxChiffres(projet.data.numero)}
  data-toc-libelle={`${deuxChiffres(projet.data.numero)} · ${projet.data.titre}`}
>
  <span class="stencil num">{deuxChiffres(projet.data.numero)}</span>
  <span class="textes">
    <span class="titre">{projet.data.titre}</span>
    <span class="categorie">{projet.data.categorie}</span>
  </span>
  <svg class="cercle" viewBox="0 0 300 60" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M20 34 C 22 10, 150 2, 270 10 C 300 14, 298 46, 250 52 C 160 60, 40 58, 14 44 C 4 38, 12 22, 40 16"
      fill="none"
      stroke="var(--rust)"
      stroke-width="2.4"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    ></path>
  </svg>
</a>

<style>
  .toc {
    position: relative;
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    align-items: center;
    gap: 8px;
    min-height: 50px;
    padding: 4px 6px;
    color: var(--ink);
    text-decoration: none;
  }

  .toc:hover,
  .toc.is-active {
    color: var(--rust);
  }

  .num {
    font-size: 22px;
    color: var(--rust);
  }

  .textes {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .titre {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.15;
  }

  .categorie {
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* Cercle au crayon : tracé de 640 px, dessiné quand l'élément devient actif */
  .cercle {
    position: absolute;
    left: 30px;
    top: -8px;
    width: calc(100% - 26px);
    height: calc(100% + 16px);
    overflow: visible;
    pointer-events: none;
  }

  .cercle path {
    stroke-dasharray: 640;
    stroke-dashoffset: 640;
    transition: stroke-dashoffset 0.7s ease;
  }

  .is-active .cercle path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cercle path {
      transition: none;
    }
  }
</style>
