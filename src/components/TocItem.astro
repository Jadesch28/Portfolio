---
// Une ligne du carnet sommaire : titre, catégorie, cercle au crayon si actif.
import type { Projet } from '../data/projets';

interface Props {
  projet: Projet;
  actif?: boolean;
}

const { projet, actif = false } = Astro.props;
---

<a
  href={`#projet-${projet.id}`}
  class:list={['toc', { 'is-active': actif }]}
  aria-current={actif ? 'true' : undefined}
  data-toc={projet.id}
  data-toc-libelle={projet.data.titre}
>
  <span class="textes">
    <span class="titre">{projet.data.titre}</span>
    <span class="categorie">{projet.data.categorie}</span>
  </span>
  <svg class="cercle" viewBox="0 0 300 60" preserveAspectRatio="none" aria-hidden="true">
    <path
      d="M20 34 C 22 10, 150 2, 270 10 C 300 14, 298 46, 250 52 C 160 60, 40 58, 14 44 C 4 38, 12 22, 40 16"
      fill="none"
      stroke="var(--rust)"
      stroke-width="2.4"
      stroke-linecap="round"
      vector-effect="non-scaling-stroke"
    ></path>
  </svg>
</a>

<style>
  .toc {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 54px;
    padding: 8px 18px 8px 26px;
    color: var(--ink);
    text-decoration: none;
  }

  .toc:hover,
  .toc.is-active {
    color: var(--rust);
  }

  .textes {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .titre {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
  }

  .categorie {
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* Cercle au crayon autour du titre (300 px de large au plus, pour que le tracé reste plus court
     que ses pointillés de 700 px), dessiné quand l'élément devient actif */
  .cercle {
    position: absolute;
    left: 0;
    top: -6px;
    width: min(100%, 300px);
    height: calc(100% + 12px);
    overflow: visible;
    pointer-events: none;
  }

  .cercle path {
    stroke-dasharray: 700;
    stroke-dashoffset: 700;
    transition: stroke-dashoffset 0.7s ease;
  }

  .is-active .cercle path {
    stroke-dashoffset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cercle path {
      transition: none;
    }
  }
</style>
