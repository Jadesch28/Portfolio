---
// Vidéo de projet : muette au départ, en boucle, preload="none", lancée quand elle est visible
// (scripts/videos.ts). L'image d'attente est le poster de la vidéo ou, à défaut, le visuel principal.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { pageProjet } from '../data/site';

interface Props {
  mp4: string;
  webm?: string;
  poster?: ImageMetadata;
  /** La vidéo a une bande son : ajoute un bouton « Activer le son ». */
  son?: boolean;
  /** Description de la vidéo pour les lecteurs d'écran. */
  label: string;
  class?: string;
}

const { mp4, webm, poster, son = false, label, class: className } = Astro.props;
const image = poster ? await getImage({ src: poster, width: 1600, format: 'webp' }) : undefined;
---

<div class:list={['video', className]} data-video>
  <video muted loop playsinline preload="none" poster={image?.src} aria-label={label}>
    {webm && <source src={webm} type="video/webm" />}
    <source src={mp4} type="video/mp4" />
  </video>
  <div class="commandes">
    {son && (
      <button
        type="button"
        class="bascule"
        aria-label={pageProjet.videoSonActiver}
        data-video-son
        data-activer={pageProjet.videoSonActiver}
        data-couper={pageProjet.videoSonCouper}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z" fill="currentColor"></path>
          <path class="icone-coupe" d="M15.5 9.5l5 5m0-5l-5 5"></path>
          <path class="icone-active" d="M15 9a4.2 4.2 0 0 1 0 6m2.6-8.6a8 8 0 0 1 0 11.2"></path>
        </svg>
      </button>
    )}
    <button
      type="button"
      class="bascule"
      aria-label={pageProjet.videoLecture}
      data-video-toggle
      data-pause={pageProjet.videoPause}
      data-lecture={pageProjet.videoLecture}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path class="icone-lecture" d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path>
        <path
          class="icone-pause"
          d="M7.5 5.5h3.2v13H7.5zm5.8 0h3.2v13h-3.2z"
          fill="currentColor"
        ></path>
      </svg>
    </button>
  </div>
</div>

<script>
  import '../scripts/videos';
</script>

<style>
  .video {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--kraft-dark);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Petites étiquettes Dymo dans le coin */
  .commandes {
    position: absolute;
    right: 10px;
    bottom: 10px;
    left: 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    pointer-events: none;
  }

  .bascule {
    min-width: 44px;
    pointer-events: auto;
    min-height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 3px;
    background-color: rgba(23, 22, 20, 0.85);
    color: var(--dymo-text);
    box-shadow: var(--sh-sm);
    cursor: pointer;
  }

  .bascule svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .bascule svg [fill] {
    stroke: none;
  }

  /* Icône selon l'état, posé par scripts/videos.ts */
  .icone-pause,
  .icone-active,
  .est-actif .icone-lecture,
  .est-actif .icone-coupe {
    display: none;
  }

  .est-actif .icone-pause,
  .est-actif .icone-active {
    display: inline;
  }

  .bascule:hover {
    background-color: var(--dymo-hover);
  }
</style>
