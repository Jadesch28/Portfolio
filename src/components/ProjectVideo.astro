---
// Vidéo de projet : muette, en boucle, preload="none", lancée quand elle est visible (scripts/videos.ts).
// L'image d'attente est le poster de la vidéo ou, à défaut, le visuel principal.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { pageProjet } from '../data/site';

interface Props {
  mp4: string;
  webm?: string;
  poster?: ImageMetadata;
  /** Description de la vidéo pour les lecteurs d'écran. */
  label: string;
  class?: string;
}

const { mp4, webm, poster, label, class: className } = Astro.props;
const image = poster ? await getImage({ src: poster, width: 1600, format: 'webp' }) : undefined;
---

<div class:list={['video', className]} data-video>
  <video muted loop playsinline preload="none" poster={image?.src} aria-label={label}>
    {webm && <source src={webm} type="video/webm" />}
    <source src={mp4} type="video/mp4" />
  </video>
  <button
    type="button"
    class="bascule"
    data-video-toggle
    data-pause={pageProjet.videoPause}
    data-lecture={pageProjet.videoLecture}
  >
    {pageProjet.videoLecture}
  </button>
</div>

<script>
  import '../scripts/videos';
</script>

<style>
  .video {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--kraft-dark);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Petite étiquette Dymo dans le coin */
  .bascule {
    position: absolute;
    right: 10px;
    bottom: 10px;
    min-width: 44px;
    min-height: 44px;
    padding: 6px 12px;
    border: 0;
    border-radius: 3px;
    background-color: rgba(23, 22, 20, 0.85);
    color: var(--dymo-text);
    font-family: var(--f-text);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    box-shadow: var(--sh-sm);
    cursor: pointer;
  }

  .bascule:hover {
    background-color: var(--dymo-hover);
  }
</style>
