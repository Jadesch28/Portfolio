---
import DecoItem from '../components/DecoItem.astro';
import DymoButton from '../components/DymoButton.astro';
import StencilRuler from '../components/StencilRuler.astro';
import { page404, site } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base title={`Page introuvable — ${site.nom}`} header="minimal" footer={false}>
  <section class="oups">
    <div class="inner">
      <div class="texte">
        <div class="anim-slide" style="--delai: 0.1s">
          <StencilRuler
            as="h1"
            title={page404.titre}
            size="clamp(150px, 18vw, 260px)"
            rotate={-4}
            class="regle"
          />
        </div>
        <p class="hand phrase anim-fade" style="--delai: 0.6s">
          {page404.phrase}
        </p>
        <p class="explication anim-fade" style="--delai: 0.8s">
          {page404.texte}
        </p>
        <div class="liens anim-fade" style="--delai: 1s">
          <DymoButton href="/" variant="rouille">
            {page404.retour}
          </DymoButton>
          <DymoButton href="/contact">{page404.prevenir}</DymoButton>
        </div>
      </div>

      <div class="bureau" aria-hidden="true">
        <div class="feuille">
          <svg class="gribouillis" width="380" height="240" viewBox="0 0 380 240">
            <path
              d="M40 90 C 80 40, 120 140, 160 80 S 240 40, 260 110 S 330 150, 340 90 M60 160 C 110 120, 150 200, 200 150 S 290 130, 320 180"
              fill="none"
              stroke="#4A4540"
              stroke-width="3"
              stroke-linecap="round"
            ></path>
          </svg>
        </div>
        <div class="gomme-pose">
          <DecoItem type="gomme" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .oups {
    display: flex;
    align-items: center;
    min-height: 100vh;
    padding: 100px clamp(16px, 6vw, 110px);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 56px;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
  }

  .texte {
    display: flex;
    flex: 1 1 480px;
    flex-direction: column;
    align-items: flex-start;
    gap: 30px;
    min-width: 0;
  }

  .texte :global(.regle .titre) {
    line-height: 0.78;
    letter-spacing: 0.04em;
  }

  .phrase {
    font-size: clamp(36px, 3.6vw, 52px);
    line-height: 1.1;
  }

  .explication {
    font-size: 19px;
    line-height: 1.6;
  }

  .liens {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .bureau {
    position: relative;
    flex: 0 1 420px;
    height: 320px;
  }

  .feuille {
    position: absolute;
    left: 0;
    top: 40px;
    width: 380px;
    max-width: 100%;
    height: 240px;
    background: var(--paper);
    box-shadow: var(--sh-md);
    transform: rotate(3deg);
  }

  .gribouillis {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .gomme-pose {
    position: absolute;
    left: 40px;
    top: 60px;
  }

  /* La gomme frotte le gribouillis, qui s'efface puis revient (boucle de 3,2 s) */
  .gomme-pose {
    animation: frotter 3.2s ease-in-out infinite;
  }

  .gribouillis {
    animation: effacer 3.2s ease-in-out infinite;
  }

  @keyframes frotter {
    0%,
    10% {
      transform: translate(0, 0) rotate(-14deg);
    }
    20% {
      transform: translate(120px, 8px) rotate(-10deg);
    }
    30% {
      transform: translate(10px, 20px) rotate(-16deg);
    }
    40% {
      transform: translate(150px, 30px) rotate(-12deg);
    }
    50% {
      transform: translate(30px, 40px) rotate(-15deg);
    }
    60% {
      transform: translate(170px, 46px) rotate(-11deg);
    }
    75%,
    100% {
      transform: translate(0, 0) rotate(-14deg);
    }
  }

  @keyframes effacer {
    0%,
    10% {
      opacity: 0.9;
    }
    70%,
    85% {
      opacity: 0;
    }
    100% {
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gomme-pose,
    .gribouillis {
      animation: none;
    }

    .gomme-pose {
      transform: rotate(-14deg);
    }
  }

  .gomme-pose :global(.gomme) {
    width: 130px;
    height: 50px;
    box-shadow: 0 8px 12px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 759.98px) {
    .oups {
      min-height: 0;
      padding: 40px 16px 60px;
    }

    .inner {
      gap: 24px;
    }

    .texte {
      flex: 1 1 100%;
      gap: 22px;
    }

    .bureau {
      flex: 1 1 100%;
      height: 280px;
    }
  }
</style>
