---
import DymoButton from '../components/DymoButton.astro';
import HeroTidy from '../components/HeroTidy.astro';
import Notebook from '../components/Notebook.astro';
import Polaroid from '../components/Polaroid.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import WashiTape from '../components/WashiTape.astro';
import { deuxChiffres, getProjets } from '../data/projets';
import { aProposCourt, contactCourt, photos, sectionProjets, site } from '../data/site';
import Base from '../layouts/Base.astro';

const projets = await getProjets();
---

<Base title={`${site.nom} — Graphiste & motion designer`}>
  <HeroTidy />

  <section id="projets" class="projets" aria-labelledby="projets-titre">
    <SectionHeading
      id="projets-titre"
      count={`${deuxChiffres(projets.length)} ${sectionProjets.compteur}`}
      title={sectionProjets.titre}
      note={sectionProjets.note}
    />
    <div class="pj">
      <Notebook projets={projets} />
      <div class="cartes">
        {projets.map((p, i) => (
          <ProjectCard projet={p} index={i} />
        ))}
      </div>
    </div>
  </section>

  <section class="apropos" aria-labelledby="apropos-titre" data-reveal>
    <div class="apropos-inner">
      <div class="apropos-photo">
        <div class="polaroid-atelier rv1">
          <Polaroid
            visuel={photos.atelier}
            width="320px"
            photoHeight="300px"
            rotate={-4}
            frame="grand"
            widthMobile="250px"
            photoHeightMobile="240px"
            rotateMobile={-3}
            sizes="(max-width: 760px) 250px, 320px"
          />
          <WashiTape left="100px" top="-14px" width={120} rotate={-3} />
          <DymoButton as="span" variant="rouille" class="age">
            {site.age}
          </DymoButton>
        </div>
      </div>
      <div class="apropos-texte">
        <DymoButton as="span" class="etiquette rv3">
          {aProposCourt.etiquette}
        </DymoButton>
        <div class="fiche rv4">
          <h2 class="hand" id="apropos-titre">
            {aProposCourt.titre}
          </h2>
          {aProposCourt.paragraphes.map((p) => (
            <p>{p}</p>
          ))}
        </div>
        <DymoButton href="/a-propos" class="suite rv4">
          {aProposCourt.lireLaSuite}
        </DymoButton>
      </div>
    </div>
  </section>

  <section class="contact" aria-labelledby="contact-titre" data-reveal>
    <div class="contact-inner">
      <DymoButton as="span" variant="rouille" class="rv3">
        {contactCourt.etiquette}
      </DymoButton>
      <h2 class="hand rv4" id="contact-titre">
        {contactCourt.phrase}
      </h2>
      <div class="contact-liens rv4">
        <DymoButton href="/contact" variant="rouille" class="ecrire">
          {contactCourt.bouton}
        </DymoButton>
        <DymoButton href={site.reseaux.instagram}>Instagram</DymoButton>
        <DymoButton href={site.reseaux.linkedin}>LinkedIn</DymoButton>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Projets */
  .projets {
    position: relative;
    padding: 110px var(--gutter) 60px;
    border-top: 1px dashed var(--dashed);
  }

  .pj {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 56px;
    max-width: 1300px;
    margin: 0 auto;
  }

  .cartes {
    flex: 1 1 560px;
    min-width: 0;
  }

  /* À propos court */
  .apropos {
    padding: 100px var(--gutter);
    border-top: 1px dashed var(--dashed);
  }

  .apropos-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
    max-width: var(--container);
    margin: 0 auto;
  }

  .apropos-photo {
    display: flex;
    flex: 1 1 360px;
    justify-content: center;
  }

  .polaroid-atelier {
    position: relative;
  }

  .polaroid-atelier :global(.age) {
    position: absolute;
    right: -30px;
    bottom: 34px;
    transform: rotate(6deg);
  }

  .apropos-texte {
    display: flex;
    flex: 1 1 420px;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .fiche {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 580px;
    padding: 26px 30px 24px;
    color: var(--ink);
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--card-redline), var(--card-redline)),
      repeating-linear-gradient(180deg, transparent 0 29px, rgba(110, 140, 120, 0.35) 29px 30px);
    background-size:
      100% 2px,
      100% 100%;
    background-position:
      0 70px,
      0 40px;
    background-repeat: no-repeat, repeat;
    box-shadow: var(--sh-md);
    transform: rotate(-1deg);
  }

  .fiche h2 {
    font-size: 38px;
    font-weight: 400;
    line-height: 1;
  }

  .fiche p {
    font-size: 17px;
    line-height: 30px;
  }

  .fiche p:last-child {
    font-weight: 700;
  }

  /* Contact court */
  .contact {
    padding: 80px var(--gutter) 100px;
  }

  .contact-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    max-width: var(--container);
    margin: 0 auto;
  }

  .contact h2 {
    max-width: 900px;
    font-size: clamp(44px, 5.6vw, 80px);
    font-weight: 400;
    line-height: 1;
  }

  .contact-liens {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 759.98px) {
    .projets {
      padding: 40px 16px 20px;
    }

    .pj {
      gap: 0;
    }

    .apropos {
      padding: 50px 16px;
    }

    /* Ordre mobile : étiquette → photo → texte → bouton */
    .apropos-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }

    .apropos-texte {
      display: contents;
    }

    .apropos-texte :global(.etiquette) {
      order: 1;
    }

    .apropos-photo {
      flex: none;
      order: 2;
      align-self: center;
    }

    .fiche {
      order: 3;
    }

    .apropos-texte :global(.suite) {
      order: 4;
    }

    .polaroid-atelier :global(.age) {
      right: -18px;
      bottom: 24px;
    }

    .fiche {
      padding: 0;
      color: var(--cream);
      background: none;
      box-shadow: none;
      transform: none;
    }

    .fiche h2 {
      font-size: 32px;
    }

    .fiche p {
      line-height: 1.6;
    }

    .contact {
      padding: 40px 16px 50px;
      border-top: 1px dashed var(--dashed);
    }

    .contact-inner {
      gap: 18px;
    }

    .contact h2 {
      font-size: 42px;
    }

    .contact-liens :global(.ecrire) {
      width: 100%;
    }
  }
</style>
