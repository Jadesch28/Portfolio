---
import AccueilSuite from '../components/AccueilSuite.astro';
import HeroTidy from '../components/HeroTidy.astro';
import { avecContexte, personne } from '../data/seo';
import { hero, site } from '../data/site';
import Base from '../layouts/Base.astro';

const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = avecContexte({
  '@graph': [
    personne(siteUrl),
    { '@type': 'WebSite', name: site.nom, url: new URL('/', siteUrl).href, inLanguage: 'fr' },
  ],
});
---

<Base title={`${site.nom} — Graphiste & motion designer`} description={hero.texte} jsonLd={jsonLd}>
  <HeroTidy />
  <AccueilSuite />
</Base>
