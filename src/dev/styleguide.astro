---
// Styleguide (dev uniquement, injecté par astro.config.ts) : les vrais composants et leurs états,
// d'après design-reference/Site-Composants.dc.html.
import { Image } from 'astro:assets';
import ACompleter from '../components/ACompleter.astro';
import DymoButton from '../components/DymoButton.astro';
import Footer from '../components/Footer.astro';
import Placeholder from '../components/Placeholder.astro';
import { deuxChiffres, getProjets, projetHref, projetSuivant } from '../data/projets';
import { aPropos } from '../data/site';
import Base from '../layouts/Base.astro';

const projets = await getProjets();
const slugs = new Set(projets.map((p) => p.id));
const liensCasses = aPropos.ceQueJeFais.cartes.flatMap((c) =>
  c.projets.filter((slug) => !slugs.has(slug)),
);
---

<Base title="Styleguide — Jade Deschuyteneer">
  <meta slot="head" name="robots" content="noindex" />

  <div class="intro">
    <div class="titre">
      <DymoButton size="sm" variant="rouille">
        Design system
      </DymoButton>
      <h1 class="stencil">COMPOSANTS &amp; TOKENS</h1>
    </div>
    <p>
      Les vrais composants du site et leurs états. Survolez les éléments interactifs pour voir leurs
      états.
    </p>
  </div>

  <section class="sec">
    <div class="sh">
      <DymoButton size="sm" variant="rouille">
        04 · Étiquettes Dymo
      </DymoButton>
      <span class="cname">
        &lt;DymoButton variant="noir | rouille | ghost | ghost-encre" size="md | sm"&gt;
      </span>
    </div>
    <div class="rangee rangee--large">
      <div class="cell">
        <span class="cname">Noir</span>
        <div class="rangee">
          <DymoButton>Défaut</DymoButton>
          <DymoButton current>Actif</DymoButton>
          <DymoButton disabled>Envoi…</DymoButton>
        </div>
      </div>
      <div class="cell">
        <span class="cname">Rouille — action principale</span>
        <div class="rangee">
          <DymoButton variant="rouille">Défaut</DymoButton>
        </div>
      </div>
      <div class="cell">
        <span class="cname">Petites (nav, tags)</span>
        <div class="rangee">
          <DymoButton size="sm" href="#">
            Mes projets
          </DymoButton>
          <DymoButton size="sm" variant="rouille" href="#">
            Contact
          </DymoButton>
          <DymoButton size="sm" variant="ghost" href="#">
            ← Retour
          </DymoButton>
        </div>
      </div>
      <div class="cell">
        <span class="cname">Sur papier</span>
        <div class="papier rangee">
          <DymoButton size="sm" variant="ghost-encre" href="#">
            Rituel
          </DymoButton>
          <DymoButton size="sm" variant="ghost-encre" href="#">
            NogoZone
          </DymoButton>
        </div>
      </div>
      <div class="cell">
        <span class="cname">Animation « impression »</span>
        <DymoButton typeIn delay={0.5}>
          Graphiste · motion designer
        </DymoButton>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sh">
      <DymoButton size="sm" variant="rouille">
        05 · Matières
      </DymoButton>
      <span class="cname">&lt;Placeholder label tone="clair | sombre"&gt;</span>
    </div>
    <div class="cell">
      <span class="cname">Visuel en attente (clair / sombre)</span>
      <div class="rangee">
        <Placeholder label="visuel" style="width: 150px; height: 110px" />
        <Placeholder label="visuel" tone="sombre" style="width: 150px; height: 110px" />
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sh">
      <DymoButton size="sm" variant="rouille">
        07 · Navigation
      </DymoButton>
      <span class="cname">&lt;Header&gt; · &lt;MobileMenu&gt; · &lt;Footer&gt;</span>
    </div>
    <div class="cell">
      <span class="cname">
        En-tête : voir le haut de cette page (sous 760 px : « Menu ☰ » ouvre le menu carnet)
      </span>
      <span class="cname">Pied de page</span>
      <div class="cadre">
        <Footer />
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sh">
      <DymoButton size="sm" variant="rouille">
        Contenu · {deuxChiffres(projets.length)} projets
      </DymoButton>
      <span class="cname">src/content/projets/*.md · src/data/site.ts</span>
    </div>
    {liensCasses.length > 0 && (
      <p class="alerte">« Ce que je fais » cite des projets inconnus : {liensCasses.join(', ')}</p>
    )}
    <div class="projets">
      {projets.map((p) => {
        const d = p.data;
        const visuels = d.blocs.flatMap((b) => ('images' in b ? (b.images ?? []) : []));
        const manquants = visuels.filter((v) => !v.src).length;
        return (
          <article class="fiche">
            <div class="vignette">
              {d.visuelPrincipal?.src ? (
                <Image src={d.visuelPrincipal.src} alt={d.visuelPrincipal.alt} width={320} />
              ) : (
                <Placeholder label={d.visuelPrincipal?.alt ?? 'visuel principal'} tone="sombre" />
              )}
            </div>
            <div class="infos">
              <p class="cname">
                {deuxChiffres(d.numero)} · {d.titreCourt} → suivant :{' '}
                {projetSuivant(projets, p).data.titreCourt}
              </p>
              <h3 class="stencil">
                <a href={projetHref(p)}>{d.titre}</a>
              </h3>
              <p class="categorie">{d.categorie}</p>
              <p>{d.resume}</p>
              <dl>
                <dt>Année</dt>
                <dd>{d.annee ?? <ACompleter />}</dd>
                <dt>Contexte</dt>
                <dd>{d.contexte ?? <ACompleter />}</dd>
                <dt>Supports</dt>
                <dd>{d.supports?.join(', ') ?? <ACompleter />}</dd>
                <dt>Disciplines</dt>
                <dd>{d.disciplines?.join(', ') ?? <ACompleter />}</dd>
                <dt>Outils</dt>
                <dd>{d.outils?.join(', ') ?? <ACompleter />}</dd>
                <dt>Vidéo</dt>
                <dd>{d.video?.mp4 ?? '—'}</dd>
                <dt>Blocs</dt>
                <dd>
                  {d.blocs.map((b) => b.type).join(' · ')} — {visuels.length - manquants} images,{' '}
                  {manquants} en attente
                </dd>
              </dl>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</Base>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    padding: 110px 64px 40px;
  }

  .titre {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  h1 {
    font-size: clamp(56px, 8vw, 110px);
    line-height: 0.85;
  }

  .intro p {
    max-width: 470px;
    font-size: 17px;
    line-height: 1.55;
  }

  .sec {
    padding: 56px 64px;
    border-top: 1px dashed var(--dashed);
  }

  .sh {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 30px;
  }

  .cname {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--mustard);
  }

  .cell {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .rangee {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .rangee--large {
    gap: 56px;
  }

  .papier {
    padding: 18px;
    background: var(--paper);
    --focus-color: var(--rust);
  }

  .cadre {
    width: 100%;
    border: 1px dashed rgba(237, 230, 211, 0.35);
  }

  .alerte {
    margin-bottom: 24px;
    padding: 12px 16px;
    background: var(--rust);
  }

  .projets {
    display: grid;
    gap: 32px;
  }

  .fiche {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
    padding-bottom: 32px;
    border-bottom: 1px dashed var(--dashed);
  }

  .vignette :global(img),
  .vignette :global(.ph) {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border: 10px solid var(--photo);
  }

  .infos {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    line-height: 1.5;
  }

  .infos h3 {
    font-size: 48px;
    line-height: 0.9;
  }

  .infos h3 a {
    text-decoration: none;
  }

  .categorie {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mustard);
  }

  dl {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 2px 12px;
    margin: 8px 0 0;
    font-size: 14px;
  }

  dt {
    color: var(--mustard);
  }

  dd {
    margin: 0;
  }

  @media (max-width: 759.98px) {
    .intro,
    .sec {
      padding-inline: 16px;
    }

    .fiche {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
