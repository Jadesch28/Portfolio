---
// Source de l'image de partage (1200 × 630) et du favicon : dev uniquement.
// npm run og (serveur de dev lancé) les capture dans public/.
// ?icone affiche le carré du favicon au lieu de l'image de partage.
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/base.css';
import DecoItem from '../components/DecoItem.astro';
import DymoButton from '../components/DymoButton.astro';
import StencilRuler from '../components/StencilRuler.astro';
import WashiTape from '../components/WashiTape.astro';
import { hero } from '../data/site';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Image de partage</title>
    <Font cssVariable="--font-stencil" preload />
    <Font cssVariable="--font-text" preload />
    <Font cssVariable="--font-hand" />
  </head>
  <body>
    <div class="og" data-capture="og">
      <div class="regle">
        <StencilRuler title={hero.prenom} subtitle={hero.nom} size="168px" rotate={-3} />
      </div>
      <div class="roles">
        <DymoButton as="span">{hero.role}</DymoButton>
        <DymoButton as="span" variant="rouille">
          {hero.roleSuite}
        </DymoButton>
      </div>
      <WashiTape left="452px" top="96px" width={130} rotate={34} />
      <WashiTape color="sauge" left="78px" top="118px" width={120} rotate={-36} />
      <DecoItem type="feuille" size={150} rotate={24} class="feuille" />
      <DecoItem type="feuille-olive" size={120} rotate={-30} class="feuille-olive" />
      <DecoItem type="crayon" rotate={-12} class="crayon" />
    </div>

    <div class="icone mat" data-capture="icone">
      <span class="stencil j">J</span>
    </div>
  </body>
</html>

<style>
  body {
    margin: 0;
  }

  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
  }

  .regle {
    position: absolute;
    left: 110px;
    top: 120px;
  }

  .roles {
    position: absolute;
    left: 128px;
    top: 440px;
    display: flex;
    gap: 12px;
  }

  .og :global(.feuille) {
    position: absolute;
    right: 160px;
    top: 120px;
  }

  .og :global(.feuille-olive) {
    position: absolute;
    right: 90px;
    top: 330px;
  }

  .og :global(.crayon) {
    position: absolute;
    right: 120px;
    bottom: 70px;
  }

  .icone {
    display: grid;
    place-items: center;
    width: 512px;
    height: 512px;
    margin-top: 40px;
  }

  .j {
    font-size: 460px;
    line-height: 1;
    color: var(--cream);
    transform: translateY(14px);
  }
</style>
